{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "jbin",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jbin",
          "match": "\\b(package|enum|message|end)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.jbin",
          "match": "\\b(i32|i64|bool|string|list|map)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.jbin",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.jbin",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.jbin",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.jbin",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.jbin",
          "match": "\\b[a-z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.jbin"
}
